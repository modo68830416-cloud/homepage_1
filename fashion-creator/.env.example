# AI Gateway provider selection (src/ai/providers/registry.ts).
# "real" = avatar generation via Vercel AI Gateway (signed-in users only —
# see avatar-wizard.tsx's useRealProvider gate; guests always get "demo"
# regardless of this value). "demo" disables real generation entirely.
NEXT_PUBLIC_AI_PROVIDER=real
# openai | gemini | flux | kling | runway | fal | replicate (reserved, not yet implemented)

# Shopify Storefront API (src/services/shopify) — optional. When both are
# set, /trends fetches real best-selling products instead of the DEMO
# catalog (falls back to DEMO automatically if the store has no products).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
